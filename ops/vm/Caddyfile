# Caddy obtains and renews a publicly trusted certificate for this hostname.
# Keep /data persistent so certificates and ACME account keys survive deployments.
34.132.226.2.nip.io {
	reverse_proxy api:8000
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

:80 {
	redir https://{host}{uri} permanent
}
