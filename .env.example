# The same twelve variables everywhere. Empty S3_ENDPOINT_URL / SQS_ENDPOINT_URL == real AWS.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://occdesk:occdesk@localhost:5432/occdesk
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=occdesk-dev-docs
SQS_ENDPOINT_URL=http://localhost:9324
# Leave SQS_QUEUE_URL EMPTY to run the API on its own, before the compose stack exists:
# with a queue URL set but nothing listening, `complete` correctly refuses with 503 rather
# than leaving a document queued for a message that was never sent.
SQS_QUEUE_URL=
SQS_DLQ_URL=
# With the stack up (make up), use these instead:
#   SQS_QUEUE_URL=http://localhost:9324/000000000000/occdesk-dev-parse
#   SQS_DLQ_URL=http://localhost:9324/000000000000/occdesk-dev-parse-dlq
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
JWT_SECRET=change-me-locally-only
JWT_TTL_MINUTES=60
MAX_UPLOAD_BYTES=26214400
WORKER_CONCURRENCY=1
LOG_LEVEL=INFO
# AI Chatbot — get your key from https://console.x.ai/
# Leave blank to disable the chat endpoint (the button will show a setup message)
# This maps to the ai_chat_key settings field (env var: AI_CHAT_KEY)
AI_CHAT_KEY=
