{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occdesk/contracts/queue-message.schema.json",
  "title": "document.parse queue message",
  "description": "The SQS envelope produced by POST /documents/{id}/complete and consumed by the worker. Standard queue, not FIFO: idempotency comes from the database unique constraints, and FIFO would cap the throughput we exist to demonstrate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "document_id", "s3_bucket", "s3_key", "sha256", "submitted_at", "trace_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "document.parse" },
    "document_id": { "type": "integer", "minimum": 1 },
    "s3_bucket": { "type": "string", "minLength": 3 },
    "s3_key": {
      "type": "string",
      "pattern": "^raw/[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9a-f]{64}\\.pdf$",
      "description": "content-addressed: the same PDF always lands on the same key"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "description": "propagated into every log line from submit to parse; one grep tells the whole story of one document"
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "kind": "document.parse",
      "document_id": 4412,
      "s3_bucket": "occdesk-dev-docs",
      "s3_key": "raw/2026/09/08/9f2c1b7d4e5a6f80912a3b4c5d6e7f8091a2b3c4d5e6f70819a2b3c4d5e6f7e1.pdf",
      "sha256": "9f2c1b7d4e5a6f80912a3b4c5d6e7f8091a2b3c4d5e6f70819a2b3c4d5e6f7e1",
      "submitted_at": "2026-09-08T17:40:00Z",
      "trace_id": "01J8W2Z9QK7M3XN5RB4T6V8YHD"
    }
  ]
}
