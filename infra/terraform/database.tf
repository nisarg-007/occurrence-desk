# ---------- Cloud SQL (PostgreSQL 16, private IP only) ----------

resource "google_sql_database_instance" "postgres" {
  name             = var.sql_instance_name
  database_version = "POSTGRES_16"
  region           = var.region

  depends_on = [google_service_networking_connection.private_vpc]

  settings {
    tier              = "db-f1-micro"
    edition           = "ENTERPRISE"
    availability_type = "ZONAL"
    disk_type         = "PD_SSD"
    disk_size         = 10

    ip_configuration {
      ipv4_enabled                                  = false
      private_network                               = data.google_compute_network.default.id
      enable_private_path_for_google_cloud_services  = true
    }

    backup_configuration {
      enabled    = true
      start_time = "03:00"
    }
  }

  deletion_protection = true
}

resource "google_sql_database" "app" {
  name     = "occdesk"
  instance = google_sql_database_instance.postgres.name
}

# The user password is managed outside Terraform (generated by m4-cloudsql-setup.sh
# and stored in Secret Manager). Importing the user lets Terraform know about it
# without overwriting the password.
resource "google_sql_user" "app" {
  name     = "occdesk"
  instance = google_sql_database_instance.postgres.name

  lifecycle {
    ignore_changes = [password]
  }
}
